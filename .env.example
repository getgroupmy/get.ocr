# Copy to .env and fill in the two secrets.

# Protects the console and /admin/api. Generate: openssl rand -hex 32
OCR_ADMIN_TOKEN=

# Encrypts queued files and stored results. Generate: openssl rand -base64 32
# Back it up separately from the data folder. If it is lost, stored results cannot be read.
OCR_STORAGE_KEY=

# Cloudflare tunnel token (only with: docker compose --profile tunnel up -d)
# TUNNEL_TOKEN=

# --- optional -----------------------------------------------------------------
# OCR_PORT=8090                  # Docker: port on the host (get.ekyc uses 8080)
# OCR_DATA_PATH=./data            # Docker: host folder for the data. Synology: /volume1/docker/ocr/data
# OCR_DATA_DIR=./data             # Without Docker (Mac mini service): where the data goes
# OCR_ENGINE=onnxruntime          # onnxruntime | openvino (CPU without AVX; add openvino to requirements.txt)
# OCR_MIN_CONFIDENCE=0.5          # lines the model is less sure of are dropped
# OCR_PDF_DPI=200                 # PDF pages are rendered at this resolution before reading
# OCR_MAX_UPLOAD_MB=20
# OCR_SYNC_MAX_PAGES=5            # POST /v1/ocr; longer PDFs go to POST /v1/jobs
# OCR_MAX_PAGES=100               # per job
# OCR_MAX_QUEUE=200               # jobs waiting before new ones get 429
# OCR_RETENTION_DAYS=7            # job results are deleted this long after completion (0 = keep)
# OCR_CORS_ORIGINS=https://app.example.com
